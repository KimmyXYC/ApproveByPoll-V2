[botapi]
enable = false
api_server = "http://127.0.0.1:8081"

[database]
# Choose "postgresql" or "sqlite". Omitting backend keeps PostgreSQL compatibility.
backend = "postgresql"
# SQLite only (relative to the working directory); PostgreSQL fields are ignored.
path = "data/approvebypoll.sqlite3"
# PostgreSQL only:
host = "127.0.0.1"
port = 5432
user = "postgres"
password = "postgres"
dbname = "postgres"

[logchannel]
enable = false
channel_id = -1001234567890
message_thread_id = 0
